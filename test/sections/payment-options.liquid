<section id="payment" class="wrapper">
  <div class="section-header">
    <div>
      <div class="badge">{{ section.settings.badge }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
  </div>
  <div class="payment-options">
    {% for block in section.blocks %}
      <div class="card">
        <div class="tag">{{ block.settings.tag }}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.copy }}</p>
        <ul>
          <li>{{ block.settings.detail_one }}</li>
          <li>{{ block.settings.detail_two }}</li>
          <li>{{ block.settings.detail_three }}</li>
        </ul>
        {% if block.settings.button_label != blank %}
          <a class="button secondary" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Payment & booking",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Secure checkout" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your payment path" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Split the glow across installments, prepay for memberships, or gift a treatment." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Complete payment" },
    { "type": "url", "id": "primary_link", "label": "Primary link", "default": "/checkout" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Payment option",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Giftable" },
        { "type": "text", "id": "title", "label": "Title", "default": "Digital gift cards" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Send a spa-day glow in seconds with branded email delivery." },
        { "type": "text", "id": "detail_one", "label": "Detail 1", "default": "Custom amounts & notes" },
        { "type": "text", "id": "detail_two", "label": "Detail 2", "default": "No expiration dates" },
        { "type": "text", "id": "detail_three", "label": "Detail 3", "default": "Redeem in-studio or online" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose amount" },
        { "type": "url", "id": "button_link", "label": "Button link", "default": "/products/gift-card" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "option", "settings": { "tag": "Giftable", "title": "Digital gift cards", "copy": "Send a spa-day glow in seconds with branded email delivery.", "detail_one": "Custom amounts & notes", "detail_two": "No expiration dates", "detail_three": "Redeem in-studio or online", "button_label": "Choose amount", "button_link": "/products/gift-card" } },
      { "type": "option", "settings": { "tag": "Membership", "title": "Glow Club", "copy": "Lock in monthly facials with members-only pricing and perks.", "detail_one": "Priority scheduling", "detail_two": "10% off skincare", "detail_three": "Member-only gua sha workshop", "button_label": "See tiers", "button_link": "/pages/membership" } },
      { "type": "option", "settings": { "tag": "Installments", "title": "Pay over time", "copy": "Checkout with Shop Pay or Klarna for split payments on packages.", "detail_one": "No hidden fees", "detail_two": "Auto-reminders", "detail_three": "Works with packages", "button_label": "Review terms", "button_link": "/policies/payment-options" } }
    ]
  },
  "presets": [
    { "name": "Payment & booking" }
  ]
}
{% endschema %}
