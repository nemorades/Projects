<section id="products" class="wrapper">
  <div class="section-header">
    <div class="section-heading">
      <div class="badge">{{ section.settings.badge }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    {% if section.settings.cta_label != blank %}
      <a class="button secondary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
  <div class="product-grid">
    {% for block in section.blocks %}
      <article class="product-card">
        <div class="product-media">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}">
          {% endif %}
          {% if block.settings.badge != blank %}
            <span class="pill">{{ block.settings.badge }}</span>
          {% endif %}
        </div>
        <div class="product-body">
          <div class="product-top">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.price != blank %}<span class="price">{{ block.settings.price }}</span>{% endif %}
          </div>
          <p>{{ block.settings.description }}</p>
          <div class="product-actions">
            {% if block.settings.cta_label != blank %}
              <a class="button" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label }}</a>
            {% endif %}
            {% if block.settings.secondary_label != blank %}
              <a class="button secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>
            {% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clinical-grade facial care" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Curated essentials designed for glow, calm, and barrier strength." },
    { "type": "text", "id": "cta_label", "label": "Secondary action label", "default": "View services" },
    { "type": "url", "id": "cta_link", "label": "Secondary action link", "default": "/pages/services" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
