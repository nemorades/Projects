      { "type": "product", "settings": { "title": "Peptide Dew Serum", "price": "$68", "description": "Tri-peptide complex visibly smooths while beta-glucan cuddles sensitive skin.", "badge": "Firm", "cta_label": "Shop now", "cta_link": "/products/peptide-dew-serum", "secondary_label": "Ingredients", "secondary_link": "/pages/ingredients" } },
      { "type": "product", "settings": { "title": "Midnight Recovery Oil", "price": "$72", "description": "Blue tansy, bisabolol, and squalane rebalance redness overnight.", "badge": "Repair", "cta_label": "Shop now", "cta_link": "/products/midnight-recovery-oil", "secondary_label": "How to use", "secondary_link": "/pages/faq" } },
