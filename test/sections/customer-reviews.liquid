<section class="section customer-reviews" id="customer-reviews">
  <div class="wrapper">
    <div class="section-header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="muted">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      <div class="review-summary">
        <div class="rating-chip">
          <div class="rating-value">{{ section.settings.average_rating }}</div>
          <div class="stars" role="img" aria-label="{{ section.settings.average_rating }} out of 5 stars">
            {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" aria-hidden="true" class="{% if section.settings.average_rating >= i %}filled{% endif %}"><path d="M12 3.5l2.7 5.5 6 .9-4.4 4.3 1 6-5.3-2.8-5.3 2.8 1-6L3.3 9.9l6-.9z"/></svg>
            {% endfor %}
          </div>
          <p class="muted">{{ section.settings.review_count }} verified reviews</p>
        </div>
        <div class="chips">
          {% if section.settings.highlights != blank %}
            {% for highlight in section.settings.highlights | split: ',' %}
              <span class="pill">{{ highlight | strip }}</span>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>

    <div class="reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="card" {{ block.shopify_attributes }}>
            <div class="review-header">
              <div class="stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                {% for i in (1..5) %}
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="{% if block.settings.rating >= i %}filled{% endif %}"><path d="M12 3.5l2.7 5.5 6 .9-4.4 4.3 1 6-5.3-2.8-5.3 2.8 1-6L3.3 9.9l6-.9z"/></svg>
                {% endfor %}
              </div>
              <div class="review-meta">
                <p class="eyebrow">{{ block.settings.title }}</p>
                <p class="muted">{{ block.settings.date }}</p>
              </div>
            </div>
            <p class="review-body">{{ block.settings.body }}</p>
            <div class="review-footer">
              <div>
                <p class="reviewer">{{ block.settings.name }}</p>
                {% if block.settings.location != blank %}
                  <p class="muted">{{ block.settings.location }}</p>
                {% endif %}
              </div>
              <div class="tags">
                {% if block.settings.skin_focus != blank %}
                  <span class="pill subtle">{{ block.settings.skin_focus }}</span>
                {% endif %}
                {% if block.settings.product != blank %}
                  <span class="pill outline">{{ block.settings.product }}</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <div class="cta-row">
        <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        {% if section.settings.secondary_text != blank %}
          <p class="muted">{{ section.settings.secondary_text }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by glowing clients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Authentic customer reviews" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Real experiences from people who trust our modern, science-backed facial routines." },
    { "type": "text", "id": "average_rating", "label": "Average rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "287" },
    { "type": "text", "id": "highlights", "label": "Highlights (comma separated)", "default": "Clean ingredients,Clinically tested,Fast shipping" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Share your story" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "default": "#contact" },
    { "type": "text", "id": "secondary_text", "label": "Secondary text", "default": "We publish every review after verification." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Skin visibly brighter" },
        { "type": "textarea", "id": "body", "label": "Review", "default": "I saw a dewy glow after just two weeks. The texture is luxe, absorbs fast, and the scent is barely there—perfect for sensitive skin." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Jasmine L." },
        { "type": "text", "id": "location", "label": "Location", "default": "Brooklyn, NY" },
        { "type": "text", "id": "skin_focus", "label": "Skin focus", "default": "Sensitivity + calm" },
        { "type": "text", "id": "product", "label": "Product", "default": "Hydra-Lift Serum" },
        { "type": "text", "id": "date", "label": "Date", "default": "July 2024" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "rating": 5, "title": "Spa-grade feel", "body": "The cleanser melts makeup and SPF without stripping. My skin feels bouncy, never tight, and the bottle looks gorgeous on the counter.", "name": "Andrea P.", "location": "Seattle, WA", "skin_focus": "Hydration + glow", "product": "Velvet Cloud Cleanser", "date": "June 2024" } },
        { "type": "review", "settings": { "rating": 4, "title": "Confidence booster", "body": "I love the lightweight moisturizer—great under makeup. The pump dispenses just enough and keeps everything hygienic.", "name": "Priya R.", "location": "Austin, TX", "skin_focus": "Barrier repair", "product": "Ceramide Dew Moisturizer", "date": "May 2024" } }
      ]
    }
  ]
}
{% endschema %}
