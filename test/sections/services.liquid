<section id="services" class="wrapper services">
  <div class="section-header">
    <div>
      <div class="badge">{{ section.settings.badge }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="actions">
      <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      <a class="button secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
  <div class="card-grid">
    {% for block in section.blocks %}
      <div class="card">
        <div class="tag">{{ block.settings.category }}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.copy }}</p>
        <div class="price">{{ block.settings.price }}</div>
        <a class="button secondary" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Signature menu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Targeted treatments" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Choose your ritual or let us curate one for your skin type, concerns, and lifestyle." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Book now" },
    { "type": "url", "id": "primary_link", "label": "Primary link", "default": "#payment" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "View policies" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link", "default": "#contact" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "category", "label": "Category", "default": "Hydration" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cloud Dew Facial" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Lactic dew peel, cryo globes, hydrating ampoule, and barrier seal." },
        { "type": "text", "id": "price", "label": "Price", "default": "$145 / 60 min" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Book this" },
        { "type": "url", "id": "link", "label": "Link", "default": "#payment" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "service", "settings": { "category": "Hydration", "title": "Cloud Dew Facial", "copy": "Lactic dew peel, cryo globes, hydrating ampoule, and barrier seal.", "price": "$145 / 60 min", "link_label": "Book this", "link": "#payment" } },
      { "type": "service", "settings": { "category": "Brightening", "title": "Luminosity Peel", "copy": "Gentle enzyme polish, vitamin C infusion, LED brightening, and cooling mask.", "price": "$165 / 75 min", "link_label": "Book this", "link": "#payment" } },
      { "type": "service", "settings": { "category": "Sculpt", "title": "Contour Lift", "copy": "Buccal massage, gua sha sculpting, microcurrent lift, and peptide finish.", "price": "$195 / 90 min", "link_label": "Book this", "link": "#payment" } }
    ]
  },
  "presets": [
    { "name": "Services" }
  ]
}
{% endschema %}
