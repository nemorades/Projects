<section class="blog-landing">
  <div class="wrapper blog-hero">
    <div>
      <div class="badge">{{ section.settings.eyebrow | escape }}</div>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="lead">{{ section.settings.subheading | escape }}</p>
      <div class="pill-row">
        <span class="pill">{{ blog.articles_count }} stories</span>
        {% if blog.tags.size > 0 %}
          <div class="pill tags-pill">
            <span>Tags</span>
            <div class="tag-crumbs">
              {% for tag in blog.tags limit: 4 %}
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="hero-card">
      <div class="hero-card__glow"></div>
      <div class="hero-card__content">
        <p class="eyebrow">Editor's picks</p>
        <h3>{{ section.settings.featured_title | escape }}</h3>
        <p>{{ section.settings.featured_text | escape }}</p>
        <a class="button" href="{{ section.settings.featured_link }}">{{ section.settings.featured_cta | escape }}</a>
      </div>
    </div>
  </div>

  <div class="wrapper blog-grid">
    {% paginate blog.articles by section.settings.per_page %}
      {% for article in paginate.items %}
        <article class="blog-card">
          <div class="blog-card__image">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 720 }}" alt="{{ article.image.alt | escape }}" loading="lazy" />
            {% else %}
              <div class="image-fallback">Facial care insight</div>
            {% endif %}
          </div>
          <div class="blog-card__body">
            <div class="blog-card__meta">
              {% if section.settings.show_dates %}
                <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
              {% endif %}
              {% if section.settings.show_author and article.author != blank %}
                <span>By {{ article.author }}</span>
              {% endif %}
            </div>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p>
            <div class="blog-card__footer">
              <div class="tag-crumbs">
                {% for tag in article.tags limit: 3 %}
                  <a href="{{ article.url }}#tags">#{{ tag }}</a>
                {% endfor %}
              </div>
              <a class="text-link" href="{{ article.url }}">Read</a>
            </div>
          </div>
        </article>
      {% else %}
        <div class="empty-state">
          <h3>No stories yet</h3>
          <p>Publish your first facial-care note to see it here.</p>
        </div>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <div class="pagination">
          {% if paginate.previous %}
            <a class="pill" href="{{ paginate.previous.url }}">← Newer</a>
          {% endif %}
          <span class="pagination__status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a class="pill" href="{{ paginate.next.url }}">Older →</a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog feed",
  "tag": "section",
  "class": "section-blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Radiant notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Insights for luminous skin"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Routine tips, ingredient spotlights, and rituals curated by our estheticians."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_dates",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured title",
      "default": "Deep hydration rituals"
    },
    {
      "type": "text",
      "id": "featured_text",
      "label": "Featured text",
      "default": "Discover the dermatologist-designed layering routine that boosts glow overnight."
    },
    {
      "type": "text",
      "id": "featured_cta",
      "label": "Featured CTA",
      "default": "Explore routine"
    },
    {
      "type": "url",
      "id": "featured_link",
      "label": "Featured link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Blog feed",
      "category": "Blog"
    }
  ]
}
{% endschema %}
