<section class="section faq" id="faq">
  <div class="wrapper">
    <div class="section-header">
      {% if section.settings.badge != blank %}
        <span class="badge">{{ section.settings.badge }}</span>
      {% endif %}
      <div class="section-heading">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.copy != blank %}
          <p class="muted">{{ section.settings.copy }}</p>
        {% endif %}
      </div>
    </div>
    <div class="faq-grid">
      {% for block in section.blocks %}
        <div class="faq-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.question }}</h3>
          <p>{{ block.settings.answer }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {"type": "text", "id": "badge", "label": "Label", "default": "Questions"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Everything you want to know"},
    {"type": "textarea", "id": "copy", "label": "Intro copy", "default": "We keep routines simple, science-backed, and tailored to your skin's comfort."}
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {"type": "text", "id": "question", "label": "Question", "default": "Are your formulas suitable for sensitive skin?"},
        {"type": "textarea", "id": "answer", "label": "Answer", "default": "Yes. Each product is dermatologically tested, fragrance-light, and designed to be layered without irritation."}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {"name": "FAQ", "category": "Content"}
  ]
}
{% endschema %}
