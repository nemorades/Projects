<header class="site-header">
  <div class="wrapper">
    <div class="brand">{{ section.settings.brand | escape }}</div>
    <nav class="nav-links" aria-label="Main navigation">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
      {% endfor %}
      {% if section.settings.cta_label != blank %}
        <a class="button secondary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Sticky header",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "Radiant Facial Cosmetics"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Book consultation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "default": "#contact"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Hero" },
        { "type": "url", "id": "link", "label": "Link", "default": "#hero" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "nav_link", "settings": { "label": "Hero", "link": "#hero" } },
      { "type": "nav_link", "settings": { "label": "Benefits", "link": "#benefits" } },
      { "type": "nav_link", "settings": { "label": "Services", "link": "#services" } },
      { "type": "nav_link", "settings": { "label": "Payment", "link": "#payment" } }
    ]
  }
}
{% endschema %}
