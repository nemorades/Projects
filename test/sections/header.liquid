<header class="site-header">
  <div class="wrapper header-grid">
    <div class="brand">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ section.settings.brand | escape }} logo" loading="lazy" />
      {% endif %}
      <div>
        <div class="brand-title">{{ section.settings.brand | escape }}</div>
        <div class="brand-note">{{ section.settings.tagline | escape }}</div>
      </div>
    </div>

    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="SiteNav">
      <span></span><span></span><span></span>
      <span class="sr-only">Toggle navigation</span>
    </button>

    <nav class="nav-links" id="SiteNav" aria-label="Main navigation">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
      {% endfor %}
      {% if section.settings.cta_label != blank %}
        <a class="button tertiary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Sticky header",
  "class": "section-header sticky",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "Radiant Facial Cosmetics"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Performance skincare, esthetician crafted"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Book consultation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "default": "#contact"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Hero" },
        { "type": "url", "id": "link", "label": "Link", "default": "#hero" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {
      "brand": "Radiant Facial Cosmetics",
      "tagline": "Performance skincare, esthetician crafted",
      "cta_label": "Book consultation",
      "cta_link": "#contact"
    },
    "blocks": [
      { "type": "nav_link", "settings": { "label": "Home", "link": "/" } },
      { "type": "nav_link", "settings": { "label": "Products", "link": "/pages/products" } },
      { "type": "nav_link", "settings": { "label": "Services", "link": "/pages/services" } },
      { "type": "nav_link", "settings": { "label": "FAQ", "link": "/pages/faq" } },
      { "type": "nav_link", "settings": { "label": "Payment", "link": "/pages/payment" } },
      { "type": "nav_link", "settings": { "label": "Reviews", "link": "/pages/reviews" } }
    ]
  },
  "presets": [
    { "name": "Sticky header" }
  ]
}
{% endschema %}
