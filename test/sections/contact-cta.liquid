<section id="contact" class="wrapper">
  <div class="section-header">
    <div>
      <div class="badge">{{ section.settings.badge }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
  </div>
  <div class="contact-grid">
    <div>
      <div class="card">
        <div class="tag">Studio details</div>
        <p>{{ section.settings.details }}</p>
        <p><strong>Phone:</strong> {{ section.settings.phone }}<br><strong>Email:</strong> {{ section.settings.email }}</p>
        <p><strong>Hours:</strong> {{ section.settings.hours }}</p>
      </div>
      <div class="card testimonial">
        <div class="step-number">★</div>
        <p class="quote">“{{ section.settings.testimonial }}”</p>
      </div>
    </div>
    <div>
      {% form 'contact', class: 'contact-form', data-contact-form: true %}
        <label for="ContactName">Name</label>
        <input id="ContactName" name="contact[name]" type="text" placeholder="Your name" required>
        <label for="ContactEmail">Email</label>
        <input id="ContactEmail" name="contact[email]" type="email" placeholder="you@example.com" required>
        <label for="ContactTopic">Service interest</label>
        <select id="ContactTopic" name="contact[service]">
          <option value="Hydration facial">Hydration facial</option>
          <option value="Brightening peel">Brightening peel</option>
          <option value="Sculpt + lift">Sculpt + lift</option>
          <option value="Payment plan">Payment plan questions</option>
        </select>
        <label for="ContactMessage">Message</label>
        <textarea id="ContactMessage" name="contact[body]" rows="4" placeholder="Tell us about your skin goals"></textarea>
        <button class="button" type="submit">{{ section.settings.button_label }}</button>
        <p class="notice" data-success hidden>Thanks! We’ll confirm within one business day.</p>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact & testimonial",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Let’s talk skin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book or ask a question" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We’re here to personalize your regimen and payment plan." },
    { "type": "textarea", "id": "details", "label": "Studio details", "default": "Visit us in the heart of the wellness district. Free parking and herbal tea on arrival." },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (555) 012-3456" },
    { "type": "text", "id": "email", "label": "Email", "default": "care@radiantfacial.com" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Tue–Sat, 10am–7pm" },
    { "type": "textarea", "id": "testimonial", "label": "Testimonial", "default": "The only facial that calms my rosacea and gives me an immediate glow." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send request" }
  ]
}
{% endschema %}
