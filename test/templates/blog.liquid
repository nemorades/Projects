<div class="wrapper page-default">
  <div class="section-header">
    <div class="section-heading">
      <div class="badge">Journal</div>
      <h1>{{ blog.title }}</h1>
      {% if blog.description != blank %}<p>{{ blog.description }}</p>{% endif %}
    </div>
  </div>
  <div class="card-grid">
    {% for article in blog.articles %}
      <article class="card">
        <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
        <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
      </article>
    {% else %}
      <p>No articles yet.</p>
    {% endfor %}
  </div>
</div>
