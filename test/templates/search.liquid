<div class="wrapper page-default">
  <div class="section-header">
    <div class="section-heading">
      <div class="badge">Search</div>
      <h1>Find your skincare</h1>
    </div>
  </div>
  <form class="search-form" action="/search" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, services, routines" />
    <button class="button" type="submit">Search</button>
  </form>
  {% if search.performed %}
    <div class="product-grid" style="margin-top: 18px;">
      {% for item in search.results %}
        <article class="product-card">
          <div class="product-body">
            <div class="product-top">
              <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
              {% if item.price %}<span class="price">{{ item.price | money }}</span>{% endif %}
            </div>
            <p>{{ item.body | strip_html | truncate: 140 }}</p>
          </div>
        </article>
      {% else %}
        <p>No results found.</p>
      {% endfor %}
    </div>
  {% endif %}
</div>
