{% section 'header' %}

<div class="wrapper collection-hero">
  <div class="section-header">
    <div class="section-heading">
      <div class="badge">Collection</div>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p>{{ collection.description }}</p>
      {% endif %}
    </div>
  </div>
  <div class="product-grid">
    {% for product in collection.products %}
      <article class="product-card">
        <div class="product-media">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}">
          {% endif %}
          {% if product.available == false %}
            <span class="pill">Sold out</span>
          {% endif %}
        </div>
        <div class="product-body">
          <div class="product-top">
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <span class="price">{{ product.price | money }}</span>
          </div>
          <p>{{ product.description | strip_html | truncate: 120 }}</p>
          <div class="product-actions">
            <a class="button" href="{{ product.url }}">View product</a>
          </div>
        </div>
      </article>
    {% else %}
      <p>No products found in this collection yet.</p>
    {% endfor %}
  </div>
</div>

{% section 'footer' %}
