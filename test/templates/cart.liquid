<div class="wrapper cart-page">
  <div class="section-header">
    <div class="section-heading">
      <div class="badge">Cart</div>
      <h1>Your bag</h1>
    </div>
    <a class="button secondary" href="/collections/all">Continue shopping</a>
  </div>
  {% if cart.item_count > 0 %}
    <form action="/cart" method="post">
      <table class="cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>{{ item.product.title }}</td>
              <td><input type="number" min="0" name="updates[]" value="{{ item.quantity }}"></td>
              <td>{{ item.price | money }}</td>
              <td>{{ item.line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p><strong>Subtotal:</strong> {{ cart.total_price | money }}</p>
      <div class="product-actions">
        <button class="button secondary" name="update">Update</button>
        <button class="button" name="checkout">Checkout</button>
      </div>
    </form>
  {% else %}
    <p>Your cart is empty.</p>
  {% endif %}
</div>
